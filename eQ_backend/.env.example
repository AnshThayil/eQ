# Copy this file to .env and fill in the values.

# --- Dev toggle ---
# Set to True to enable DEBUG mode locally. Never set in production.
DJANGO_DEBUG=True

# Secret key — leave blank in dev to use the insecure default; set a strong random value in production.
SECRET_KEY=

# --- Database (PostgreSQL) ---
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# --- YoActiv API ---
# YoActiv API key
YOACTIV_API_KEY=your_yoactiv_api_key_here

# YoActiv Branch ID (used for admin integration to fetch services and variations)
YOACTIV_BRANCH_ID=your_yoactiv_branch_id_here

# Optional: override the default YoActiv API base URL
YOACTIV_BASE_URL=https://api.yoactiv.com/
